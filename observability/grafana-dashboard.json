{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Endpoint Health Monitor Telemetry",
  "panels": [
    {
      "title": "Endpoint Availability (UP/DOWN)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "endpoint_up",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "title": "Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(endpoint_response_time_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} p95"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
